# ============================================
# VIN-15 — biến môi trường. cp .env.example .env rồi điền. KHÔNG commit .env.
# be/ và agent/ cùng đọc file .env này ở gốc repo.
# ============================================

# ---- Ứng dụng (BE, cổng 8000) ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# ---- Database: Supabase Postgres ----
# Supabase → Project Settings → Database → Connection string (Session pooler hoặc Direct), thêm ?sslmode=require
# Trống hoặc không phải postgresql:// thì BE chạy KHÔNG database (chỉ health).
# DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Tự áp migration be/src/vin15/resources/db/migration/V*.sql khi BE khởi động
MIGRATIONS_ENABLED=true

# ---- Supabase API (chưa dùng; secret key bỏ qua RLS, TUYỆT ĐỐI không đưa lên frontend) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ---- Xác thực ----
# ĐỔI khi triển khai thật (>= 32 ký tự). APP_ENV=production sẽ từ chối giá trị mặc định.
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=480
# Email quản trị viên khởi tạo, có thể nhiều email cách nhau dấu phẩy (vd a@x.vn,b@x.vn). QTV mời GV, GV mời SV.
APP_ADMIN_EMAILS=
# Google OAuth — Google Cloud Console → APIs & Services → Credentials. Phải đăng ký đúng REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---- Service agent (chạy riêng, cổng 8100) ----
# BE gọi agent tại AGENT_API_URL kèm token. Hai bên PHẢI dùng cùng AGENT_API_SERVICE_TOKEN.
AGENT_API_URL=http://localhost:8100
AGENT_API_PORT=8100
AGENT_API_SERVICE_TOKEN=agent-api-local-only

# ---- LLM (chỉ agent dùng, BE không giữ khóa LLM) ----
OPENAI_API_KEY=
# Endpoint tương thích OpenAI (proxy AiClient). Trống = api.openai.com
OPENAI_BASE_URL=

# ---- Email (Gmail SMTP, dùng App Password — KHÔNG dùng mật khẩu Gmail) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Lưu tệp minh chứng: Cloudflare R2 (tương thích S3) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- AI Hook Logging (do giảng viên cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log
