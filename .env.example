# ============================================
# VIN-15 — biến môi trường. cp .env.example .env rồi điền. KHÔNG commit .env.
# be/ và agent/ cùng đọc file .env này ở gốc repo.
# ============================================

# ---- Ứng dụng (BE, cổng 8000) ----
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
APP_TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO

# ---- Database: Supabase Postgres ----
# Supabase → Project Settings → Database → Connection string (Session pooler hoặc Direct), thêm ?sslmode=require
# Trống hoặc không phải postgresql:// thì BE chạy KHÔNG database (chỉ health).
# DATABASE_URL=postgresql://postgres.<project-ref>:<mật-khẩu>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=
# Tự áp migration be/src/vin15/resources/db/migration/V*.sql khi BE khởi động
MIGRATIONS_ENABLED=true

# ---- Supabase API (chưa dùng; secret key bỏ qua RLS, TUYỆT ĐỐI không đưa lên frontend) ----
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# ---- Xác thực ----
# ĐỔI khi triển khai thật (>= 32 ký tự). APP_ENV=production sẽ từ chối giá trị mặc định.
JWT_SECRET=dev-only-change-me
JWT_TTL_MINUTES=480
# Email quản trị viên khởi tạo, có thể nhiều email cách nhau dấu phẩy (vd a@x.vn,b@x.vn). QTV mời GV, GV mời SV.
APP_ADMIN_EMAILS=
# Google OAuth — Google Cloud Console → APIs & Services → Credentials. Phải đăng ký đúng REDIRECT_URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ---- Frontend Next.js (fe/, cổng 3000) ----
# FE chuyển tiếp /api/* sang BE (rewrites trong fe/next.config.ts). scripts/start.sh tự đặt BE_URL theo APP_PORT;
# chạy riêng (npm run dev) mà BE không ở localhost:8000 thì đặt BE_URL trong môi trường.
NEXT_PORT=3000

# ---- Service agent (chạy riêng, cổng 8100) ----
# BE gọi agent tại AGENT_API_URL kèm token. Hai bên PHẢI dùng cùng AGENT_API_SERVICE_TOKEN.
AGENT_API_URL=http://localhost:8100
AGENT_API_PORT=8100
AGENT_API_SERVICE_TOKEN=agent-api-local-only

# ---- LLM (chỉ agent dùng, BE không giữ khóa LLM) ----
# Đường chính: gọi thẳng OpenAI. OPENAI_BASE_URL trống = api.openai.com.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=2048
OPENAI_TIMEOUT_SECONDS=30
# Đường dự phòng: proxy AiClient (tương thích OpenAI). Chỉ dùng khi đường chính lỗi tạm thời. Trống BASE_URL = tắt.
AICLIENT_BASE_URL=
AICLIENT_API_KEY=
AICLIENT_MODEL=

# ---- Trợ lý hỏi đáp chính sách (agent hỏi đáp) ----
# Agent
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ASSISTANT_TEMPERATURE=0.2
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_TURN_SECONDS=25
# Agent gọi ngược BE để lấy quy định và dữ liệu cá nhân (tool chỉ-đọc). Khác BE_URL của FE.
BE_API_URL=http://localhost:8000
# Regex mã sinh viên để che PII (trống = không che theo mã)
PII_STUDENT_ID_PATTERN=
SCHOOL_NAME=Trường
# Khả năng của proxy dự phòng, cách nhau dấu phẩy: tools,stream,embed (trống = proxy chỉ chat thường)
AICLIENT_CAPABILITIES=
AGENT_TOOL_TIMEOUT_SECONDS=8
ASSISTANT_MAX_CONCURRENT_TURNS=50
ASSISTANT_SAMPLE_NOTICE=true
# BE
POLICY_NO_MATCH_THRESHOLD=0.25
# CHỈ DEV: tool của agent dùng người dùng này khi không có agent-token. Production từ chối khi đặt.
# scripts/start.sh tự đặt sv.a@example.test khi để trống và APP_ENV khác production (cần `make seed-dev` một lần).
AGENT_DEV_DEFAULT_USER_EMAIL=
ASSISTANT_ASK_PER_MINUTE=10
ASSISTANT_MAX_CONNECTIONS_PER_USER=3
ASSISTANT_MAX_FRAME_BYTES=65536
ASSISTANT_HISTORY_TURNS=6
ASSISTANT_WS_AUTH_SECONDS=5
# FE: đặt khi Next rewrites không chuyển được WebSocket (vd ws://localhost:8000)
NEXT_PUBLIC_BE_WS_URL=

# ---- Email (Gmail SMTP, dùng App Password — KHÔNG dùng mật khẩu Gmail) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Lưu tệp minh chứng: Cloudflare R2 (tương thích S3) ----
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# ---- AI Hook Logging (do giảng viên cấp) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=<get-your-api-key-from-dashboard-phoenix>
AI_LOG_DIR=.ai-log

# ---- Nghiệp vụ thực tập ----
APP_BASE_URL=http://localhost:3000
CURRENT_COHORT=2026-K1
# Trống = lưu tệp ở .data/files (khi chưa cấu hình R2_*)
STORAGE_LOCAL_DIR=
UPLOAD_MAX_BYTES=10485760
# LMS mini nằm trong hệ thống; đổi adapter khi tích hợp LMS thật
LMS_ADAPTER=mini
LMS_INTERNSHIP_COURSE_CODE=TT-101
LMS_INTERNSHIP_CREDITS=4
# Job nền (đánh dấu quá hạn, email tổng hợp, giám sát, đồng bộ LMS)
JOBS_ENABLED=true
JOBS_INTERVAL_SECONDS=300
DAILY_DIGEST_HOUR=7
MONITOR_ENABLED=true

